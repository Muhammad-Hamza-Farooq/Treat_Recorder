# =============================================================================
# TreatTracker — Environment Variables (EXAMPLE / TEMPLATE)
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file with real secrets.
# See SECRETS.md for exact places to copy each value from.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production example: https://treattracker.vercel.app

# Allowed invitation email domain (student IDs become <id>@<domain>)
ALLOWED_EMAIL_DOMAIN=itu.edu.pk

# Leader bootstrap (Hamza). Must match an invited/allowed member email.
LEADER_EMAIL=bscs23057@itu.edu.pk

# Secret used by Vercel Cron / scheduled reminder routes
CRON_SECRET=replace_with_long_random_string

# -----------------------------------------------------------------------------
# Supabase (Database + Auth)
# Dashboard: https://supabase.com/dashboard/project/djvjczjffxqncuqjdzrs/settings/api
# Project URL:
#   https://djvjczjffxqncuqjdzrs.supabase.co
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://djvjczjffxqncuqjdzrs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# -----------------------------------------------------------------------------
# Resend (Email)
# Dashboard: https://resend.com/api-keys
# From address must use a verified domain in Resend
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Until you verify your own domain in Resend, use the shared test sender:
RESEND_FROM_EMAIL=TreatTracker <onboarding@resend.dev>
# Production (after DNS verify): TreatTracker <noreply@yourdomain.com>

# -----------------------------------------------------------------------------
# Axiom (Structured logging / audit stream)
# Dashboard: https://app.axiom.co → Settings → API Tokens / Datasets
# -----------------------------------------------------------------------------
AXIOM_TOKEN=xaat-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AXIOM_DATASET=treattracker
AXIOM_ORG_ID=

# -----------------------------------------------------------------------------
# Optional: storage for review photos (can use Supabase Storage)
# Leave blank initially; Phase 6 can enable uploads.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=treat-reviews
